---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import VideoGallery from '../components/VideoGallery.astro';
import TravelMap from '../components/TravelMap.astro';
import siteMetadata from '../../content/site/meta.json';
import ethereumProjects from '../../content/ethereum/projects.json';
import videos from '../../content/videos/videos.json';
import photos from '../../content/photography/photos.json';
import runningStats from '../../content/running/stats.json';
import profilePics from '../../content/site/profile-pics.json';

// Blog posts for preview section (all published, newest first)
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const runningNumberFormatter = new Intl.NumberFormat('en-US');
const fallbackRunningMiles = runningNumberFormatter.format(Math.round(runningStats.totals.miles));
const fallbackRunningRuns = runningNumberFormatter.format(runningStats.totals.runs);
const fallbackRunningCountries = runningNumberFormatter.format(runningStats.totals.countries);
const fallbackRunningAsOf = new Date(`${runningStats.timePeriod.end}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={siteMetadata.title} description={siteMetadata.description}>
  <!-- Organization Schema for consulting businesses -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'ProfessionalService',
          'name': 'RBK Strategies',
          'url': 'https://rbkstrategies.com',
          'description': 'Management and financial consulting — operations, finance, and blockchain strategy.',
          'founder': {
            '@type': 'Person',
            'name': 'Rex Kirshner',
            'url': 'https://rexkirshner.com',
          },
        },
        {
          '@type': 'ProfessionalService',
          'name': 'Scratch Space',
          'url': 'https://scratchspace.dev',
          'description': 'Technical development agency specializing in custom software solutions.',
          'founder': {
            '@type': 'Person',
            'name': 'Rex Kirshner',
            'url': 'https://rexkirshner.com',
          },
        },
      ],
    })}
  />

  <!-- About Section -->
  <section id="home" class="pt-8 pb-20 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl md:text-6xl font-bold mb-12 text-center">Rex Kirshner</h1>

      <!-- Profile Image + Bio -->
      <div class="flex flex-col md:flex-row gap-8 mb-12 items-start">
        <!-- Profile Image Carousel -->
        <div class="flex-shrink-0 w-full md:w-64">
          <div id="profile-carousel" class="relative aspect-[4/5] rounded-lg overflow-hidden shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500" tabindex="0" role="region" aria-label="Profile photos, use arrow keys to navigate" aria-live="polite">
            {profilePics.map((pic, index) => (
              <img
                src={pic.src}
                srcset={pic.srcset}
                sizes="(max-width: 768px) 100vw, 256px"
                alt={pic.alt}
                class="profile-image absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
                style={index === 0 ? 'opacity: 1' : 'opacity: 0'}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            ))}
          </div>
        </div>

        <!-- Bio Text -->
        <div class="flex-1">
          <p class="text-lg text-gray-700 leading-relaxed">
            I travel. I take photos and videos. I run. I believe great stories happen to those who can tell them.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mt-6">
            I'm a researcher, content creator, and consultant. Building off an education in computer science and
            a background in corporate finance, I provide strategic consulting to growing businesses while creating
            educational resources about Ethereum, hosting podcasts, and building communities around decentralized technology.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mt-6">
            I also believe that Ethereum is the world computer—a globally shared piece of technology that will make
            the world more open, fair, and trustworthy.
          </p>
        </div>
      </div>

      <!-- Social Links -->
      <div class="mt-12">
        <h3 class="text-2xl font-bold mb-6 text-center">Connect</h3>
        <div class="grid grid-cols-3 justify-items-center gap-x-2 gap-y-3 sm:flex sm:justify-center sm:gap-6 sm:flex-wrap">
          <!-- Email -->
          <a
            href={`mailto:${siteMetadata.social.email}`}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">Email</span>
          </a>

          <!-- Twitter -->
          <a
            href={siteMetadata.social.twitter}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">Twitter</span>
          </a>

          <!-- LinkedIn -->
          <a
            href={siteMetadata.social.linkedin}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">LinkedIn</span>
          </a>

          <!-- Telegram -->
          <a
            href={siteMetadata.social.telegram}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">Telegram</span>
          </a>

          <!-- WhatsApp -->
          <a
            href={siteMetadata.social.whatsapp}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.436-9.894 9.891-9.894 2.641 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.9 6.993c-.003 5.45-4.447 9.894-9.895 9.894m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">WhatsApp</span>
          </a>

          <!-- Discord -->
          <a
            href={siteMetadata.social.discord}
            class="flex flex-col items-center gap-1 sm:gap-2 p-1 sm:p-4 rounded-lg hover:bg-gray-50 transition-colors group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5 sm:w-8 sm:h-8 text-gray-700 group-hover:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">Discord</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ profilePicsCount: profilePics.length }}>
    // Profile carousel auto-rotation - defer until after page load
    window.addEventListener('load', () => {
      let currentProfileIndex = 0;
      const profileImages = document.querySelectorAll('.profile-image');
      const carousel = document.getElementById('profile-carousel');
      const rotationInterval = 10000; // 10 seconds
      let intervalId = null;
      let isPaused = false;

      function showImage(index) {
        // Fade out all images
        profileImages.forEach(img => img.style.opacity = '0');
        // Fade in target image
        profileImages[index].style.opacity = '1';
        currentProfileIndex = index;
      }

      function rotateProfile() {
        if (isPaused) return;
        showImage((currentProfileIndex + 1) % profilePicsCount);
      }

      function goToNext() {
        showImage((currentProfileIndex + 1) % profilePicsCount);
      }

      function goToPrev() {
        showImage((currentProfileIndex - 1 + profilePicsCount) % profilePicsCount);
      }

      // Keyboard navigation
      carousel?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          goToNext();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          goToPrev();
        }
      });

      // Pause on focus, resume on blur
      carousel?.addEventListener('focus', () => {
        isPaused = true;
      });
      carousel?.addEventListener('blur', () => {
        isPaused = false;
      });

      // Start rotation
      intervalId = setInterval(rotateProfile, rotationInterval);
    });
  </script>

  <!-- Consulting Section -->
  <section id="consulting" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-12 text-center">Consulting & Services</h2>

      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          <strong>RBK Strategies</strong> provides management and financial consulting—helping businesses with
          operations, finance, and blockchain strategy. <strong>Scratch Space</strong> is a technical development
          agency specializing in custom software solutions.
        </p>

        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Whether you need strategic guidance to scale your business or custom software built from scratch,
          we bring hands-on experience to every engagement.
        </p>

        <div class="text-center flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://rbkstrategies.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-lg transition-colors shadow-lg"
          >
            Visit RBK Strategies
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="https://scratchspace.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-lg transition-colors shadow-lg"
          >
            Visit Scratch Space
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications Section -->
  <section id="technology" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-12 text-center">Publications</h2>
      <div class="grid xl:grid-cols-3 gap-8">

        {/* Blog */}
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h3 class="text-2xl font-bold mb-2">Blog</h3>
          <p class="text-gray-700 mb-4">Essays on AI agents, Ethereum, decentralization, and the tools we use to build. Writing about what I'm learning at the frontier of technology.</p>
          {blogPosts.length > 0 && (
            <ul class="space-y-2 mb-4">
              {blogPosts.slice(0, 3).map((post) => {
                const formattedDate = post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                });
                return (
                  <li class="flex flex-col">
                    <time
                      datetime={post.data.date.toISOString()}
                      class="text-xs text-gray-400 tabular-nums"
                    >
                      {formattedDate}
                    </time>
                    <a
                      href={`/blog/${post.id}`}
                      class="text-gray-700 hover:text-blue-600 transition-colors text-sm"
                    >
                      {post.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <a
            href="/blog"
            class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center"
          >
            View all posts →
          </a>
        </div>

        {/* Podcasts */}
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h3 class="text-2xl font-bold mb-2">Podcasts</h3>
          <p class="text-gray-700 mb-4">Conversations about Ethereum, crypto, and the future of decentralized technology.</p>
          <div class="space-y-4">
            {ethereumProjects.filter(p => p.type === 'Podcast').map((podcast) => (
              <div class="flex items-center gap-3">
                {podcast.image && (
                  <img
                    src={podcast.image}
                    alt={podcast.title}
                    class="w-14 h-14 rounded-lg object-cover flex-shrink-0"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div>
                  <a
                    href={podcast.link}
                    target={podcast.link.startsWith('/') ? undefined : "_blank"}
                    rel={podcast.link.startsWith('/') ? undefined : "noopener noreferrer"}
                    class="text-sm font-semibold text-gray-900 hover:text-blue-600 transition-colors"
                  >
                    {podcast.title}
                  </a>
                  <p class="text-xs text-gray-500">{podcast.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Wiki */}
        {ethereumProjects.filter(p => p.id === 'inevitable-ethereum').map((wiki) => (
          <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
            <h3 class="text-2xl font-bold mb-2">{wiki.title}</h3>
            <p class="text-gray-700 mb-4">{wiki.description}</p>
            {wiki.image && (
              <img
                src={wiki.image}
                alt={wiki.title}
                class="w-full rounded-lg mb-4"
                loading="lazy"
                decoding="async"
              />
            )}
            <a
              href={wiki.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center"
            >
              Visit Wiki →
            </a>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- Creative Section -->
  <section id="creative" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-12 text-center">Creative</h2>

      <!-- Introduction -->
      <div class="max-w-3xl mx-auto mb-12 text-center">
        <p class="text-lg text-gray-700 leading-relaxed">
          Photos and videos let us travel back in time. They let us re-experience the best moments of life.
          I capture everything on my iPhone (and occasionally a GoPro or drone).
        </p>
      </div>

      <!-- Travel Map (Collapsible) -->
      <div class="mb-20">
        <button
          id="travel-map-toggle"
          class="mx-auto flex items-center gap-2 px-6 py-3 bg-white hover:bg-gray-100 rounded-lg transition-colors font-semibold text-gray-900 shadow-md"
        >
          <span>View Travel Map</span>
          <svg id="travel-map-icon" class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="travel-map-container" class="hidden mt-6">
          <TravelMap />
        </div>
      </div>

      <!-- Videos Subsection -->
      <div class="mb-20">
        <h3 class="text-3xl font-bold mb-8 text-center">Videos</h3>
        <VideoGallery videos={videos} />
      </div>

      <!-- Photography Subsection -->
      <div>
        <h3 class="text-3xl font-bold mb-8 text-center">Photography</h3>
        <PhotoGallery photos={photos} />
      </div>
    </div>
  </section>

  <script>
    // Travel map toggle with lazy loading
    const travelMapToggle = document.getElementById('travel-map-toggle');
    const travelMapContainer = document.getElementById('travel-map-container');
    const travelMapIcon = document.getElementById('travel-map-icon');
    let mapInitialized = false;

    travelMapToggle?.addEventListener('click', async () => {
      const isHidden = travelMapContainer?.classList.contains('hidden');

      if (isHidden) {
        travelMapContainer?.classList.remove('hidden');
        travelMapIcon?.classList.add('rotate-180');

        // Initialize map on first open
        if (!mapInitialized) {
          const initMap = (window as any).__initTravelMap;
          if (initMap) {
            await initMap();
            mapInitialized = true;
          }
        }
      } else {
        travelMapContainer?.classList.add('hidden');
        travelMapIcon?.classList.remove('rotate-180');
      }
    });
  </script>

  <!-- Running Section -->
  <section id="running" class="pt-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-12 text-center">Running</h2>
    </div>

    <div class="running-trailer-section">
      <picture class="running-trailer-poster" aria-hidden="true">
        <source
          media="(max-width: 767px)"
          srcset="https://cdn.rexkirshner.com/videos/running/trailer/running-trailer-poster-mobile.jpg"
        />
        <img
          src="https://cdn.rexkirshner.com/videos/running/trailer/running-trailer-poster-desktop.jpg"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>

      <video
        id="running-trailer-video"
        class="running-trailer-video"
        data-desktop-src="https://cdn.rexkirshner.com/videos/running/trailer/running-trailer-desktop.mp4"
        data-mobile-src="https://cdn.rexkirshner.com/videos/running/trailer/running-trailer-mobile.mp4"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>

      <div class="running-trailer-shade" aria-hidden="true"></div>

      <div class="running-trailer-content">
        <p class="running-trailer-kicker">Running the world since 2016</p>
        <h2>
          <span data-running-stat="miles">{fallbackRunningMiles}</span> miles<br />
          <em>and counting.</em>
        </h2>

        <div class="running-trailer-stats" aria-live="polite">
          <span><b data-running-stat="runs">{fallbackRunningRuns}</b> runs</span>
          <i aria-hidden="true"></i>
          <span><b data-running-stat="countries">{fallbackRunningCountries}</b> countries</span>
          <i aria-hidden="true"></i>
          <span data-running-stat="as-of">Updated {fallbackRunningAsOf}</span>
        </div>

        <a class="running-trailer-link" href="https://running.rexkirshner.com/">
          Explore the full journey <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    interface LiveRunningStats {
      schema: string;
      asOf?: string;
      miles: number;
      runs: number;
      countries: number;
    }

    const runningSection = document.getElementById('running');
    const runningTrailer = document.getElementById('running-trailer-video') as HTMLVideoElement | null;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const runningNumberFormatter = new Intl.NumberFormat('en-US');
    let runningTrailerLoaded = false;
    let runningStatsLoaded = false;

    function loadRunningTrailer() {
      if (!runningTrailer || runningTrailerLoaded || reducedMotion.matches) return;

      const source = window.matchMedia('(max-width: 767px)').matches
        ? runningTrailer.dataset.mobileSrc
        : runningTrailer.dataset.desktopSrc;

      if (!source) return;

      runningTrailer.src = source;
      runningTrailerLoaded = true;
      runningTrailer.load();
    }

    async function loadLiveRunningStats() {
      if (runningStatsLoaded) return;
      runningStatsLoaded = true;

      try {
        const response = await fetch('https://running.rexkirshner.com/api/stats.json');
        if (!response.ok) throw new Error(`Running stats request failed: ${response.status}`);

        const stats = await response.json() as LiveRunningStats;
        const validStats = stats.schema === 'running-stats/1'
          && Number.isFinite(stats.miles)
          && Number.isFinite(stats.runs)
          && Number.isFinite(stats.countries);

        if (!validStats) throw new Error('Unexpected running stats response');

        (['miles', 'runs', 'countries'] as const).forEach((key) => {
          document.querySelectorAll(`[data-running-stat="${key}"]`).forEach((element) => {
            element.textContent = runningNumberFormatter.format(stats[key]);
          });
        });

        if (typeof stats.asOf === 'string') {
          const asOf = new Date(`${stats.asOf}T00:00:00Z`).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          });

          document.querySelectorAll('[data-running-stat="as-of"]').forEach((element) => {
            element.textContent = `Updated ${asOf}`;
          });
        }

        runningSection?.setAttribute('data-stats-source', 'live');
      } catch {
        // Keep the bundled values visible if the live endpoint is unavailable.
      }
    }

    function activateRunningSection() {
      loadLiveRunningStats();
      loadRunningTrailer();

      if (!reducedMotion.matches) {
        runningTrailer?.play().catch(() => {
          runningTrailer?.classList.remove('is-playing');
        });
      }
    }

    runningTrailer?.addEventListener('playing', () => {
      runningTrailer.classList.add('is-playing');
    });

    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) {
        runningTrailer?.pause();
        runningTrailer?.classList.remove('is-playing');
      } else if (runningSection && runningSection.getBoundingClientRect().top < window.innerHeight) {
        activateRunningSection();
      }
    });

    if (runningSection && 'IntersectionObserver' in window) {
      const runningObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activateRunningSection();
          } else {
            runningTrailer?.pause();
          }
        });
      }, { rootMargin: '400px 0px' });

      runningObserver.observe(runningSection);
    } else {
      activateRunningSection();
    }
  </script>

  <style>
    .running-trailer-section {
      position: relative;
      min-height: clamp(620px, 78vh, 820px);
      overflow: hidden;
      isolation: isolate;
      background: #07070c;
      color: #e9e6df;
    }

    .running-trailer-poster,
    .running-trailer-poster img,
    .running-trailer-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .running-trailer-poster img,
    .running-trailer-video {
      object-fit: cover;
    }

    .running-trailer-video {
      z-index: 1;
      opacity: 0;
      transition: opacity 600ms ease;
    }

    .running-trailer-video.is-playing {
      opacity: 1;
    }

    .running-trailer-shade {
      position: absolute;
      z-index: 2;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(5, 5, 9, 0.97) 0%, rgba(5, 5, 9, 0.74) 36%, rgba(5, 5, 9, 0.1) 69%),
        linear-gradient(0deg, rgba(5, 5, 9, 0.55), transparent 54%);
      pointer-events: none;
    }

    .running-trailer-content {
      position: relative;
      z-index: 3;
      width: min(1280px, 100%);
      min-height: inherit;
      margin: 0 auto;
      padding: 7rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }

    .running-trailer-kicker {
      margin: 0 0 1.25rem;
      color: #b55f43;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }

    .running-trailer-content h2 {
      margin: 0;
      font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      font-size: clamp(4rem, 7vw, 7rem);
      font-weight: 400;
      letter-spacing: -0.055em;
      line-height: 0.88;
    }

    .running-trailer-content h2 > span {
      color: #e8d6a9;
    }

    .running-trailer-content h2 em {
      font-weight: 400;
    }

    .running-trailer-stats {
      margin: 2rem 0 1.75rem;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      color: #827d82;
      font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      font-size: 0.95rem;
    }

    .running-trailer-stats b {
      color: #d8d1c4;
      font-weight: 400;
    }

    .running-trailer-stats i {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: #b55f43;
    }

    .running-trailer-link {
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(209, 173, 98, 0.38);
      color: #dcd6ca;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-decoration: none;
      text-transform: uppercase;
      transition: border-color 180ms ease, color 180ms ease;
    }

    .running-trailer-link span {
      color: #d1ad62;
    }

    .running-trailer-link:hover,
    .running-trailer-link:focus-visible {
      border-color: #d1ad62;
      color: #fffaf0;
      outline: none;
    }

    .running-trailer-link:focus-visible {
      box-shadow: 0 3px 0 #07070c, 0 5px 0 #d1ad62;
    }

    @media (max-width: 767px) {
      .running-trailer-section {
        min-height: min(820px, calc(100svh - 4rem));
      }

      .running-trailer-shade {
        background:
          linear-gradient(180deg, rgba(5, 5, 9, 0.98) 0%, rgba(5, 5, 9, 0.78) 39%, rgba(5, 5, 9, 0.12) 68%),
          linear-gradient(0deg, rgba(5, 5, 9, 0.4), transparent 50%);
      }

      .running-trailer-content {
        padding: 4.5rem 1.5rem 3rem;
        justify-content: flex-start;
      }

      .running-trailer-content h2 {
        max-width: 21rem;
        font-size: clamp(3.5rem, 15vw, 5rem);
      }

      .running-trailer-stats {
        max-width: 19rem;
        margin: 1.5rem 0;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        font-size: 0.85rem;
      }

      .running-trailer-stats i:last-of-type {
        display: none;
      }

      .running-trailer-stats [data-running-stat="as-of"] {
        flex-basis: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .running-trailer-video {
        display: none;
      }
    }
  </style>
</BaseLayout>
